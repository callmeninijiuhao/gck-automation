# Discrepancy Check-in backend secrets — copy to server/.env and fill in.
# server/.env is gitignored; NEVER commit real values.

# Email (Office365 SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_RECIPIENTS=gckops@pubmatic.com,aditya.bhattacharya@pubmatic.com,archan.saha@pubmatic.com,rohan.srivastava@pubmatic.com,shivaprasad.vp@pubmatic.com

# Slack — Discrepancy Check-in bot (sending reports; needs chat:write)
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#gck-discrepancy-checkin

# Slack — Top Bundle & Domain Analysis (auto-fetch the Looker CSV from a channel).
# This is a SEPARATE Slack app from the Discrepancy bot. Needs scopes:
#   files:read  (+ groups:history for private channels)  — and the bot must be in the channel.
# If the token is left blank, the tool falls back to SLACK_BOT_TOKEN above.
LOOKER_SLACK_BOT_TOKEN=
# The channel to pull the Looker CSV from — must be the channel ID (e.g. C0123ABCD), NOT #name.
LOOKER_SLACK_CHANNEL=
# Optional: only pick files whose name contains this (e.g. bundle). Leave blank for the newest CSV.
LOOKER_SLACK_MATCH=

# PubMatic Brain API (LLM narrative for Top Bundle & Domain Analysis)
# Non-prod (stage) for dev/CICD — keys end in -dev-stage or -cicd-stage.
# Prod endpoint is https://llm.pubmatic.com/v1/chat/completions (prod keys only).
BRAIN_LLM_ENDPOINT=https://stagellm.pubmatic.com/v1/chat/completions
BRAIN_LLM_API_KEY=
# Model — must match a name from `node scripts/debug-topbundle.mjs models` (they include a
# "(paid) " prefix). Default = Sonnet 5; top quality: (paid) claude-opus-4-8; cheapest:
# (paid) claude-haiku-4.5. The app sends its own model from the UI; this is the debug default.
BRAIN_LLM_MODEL=(paid) claude-sonnet-5
# Optional Langfuse tracing:
# LANGFUSE_TRACE_METADATA={"tag":"Top Bundle Analysis"}
# LANGFUSE_TRACE_USER_ID=
