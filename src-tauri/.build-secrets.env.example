# Build-time sending credentials — copy to src-tauri/.build-secrets.env and fill in.
# .build-secrets.env is gitignored; NEVER commit real values.
# When present at `npm run tauri:build` time, these are embedded into the app
# and the in-app "Sending Settings" card is hidden from users.
#
# SECURITY NOTE: embedded values can be extracted from the binary by a
# determined user. Use a shared low-privilege service account (e.g. gckops)
# with an app-specific password, and rotate credentials periodically.

EMBED_SMTP_HOST=smtp.office365.com
EMBED_SMTP_PORT=587
EMBED_EMAIL_USER=
EMBED_EMAIL_PASSWORD=
EMBED_SLACK_BOT_TOKEN=
