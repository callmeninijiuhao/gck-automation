# Build-time sending credentials — copy to src-tauri/.build-secrets.env and fill in.
# .build-secrets.env is gitignored; NEVER commit real values.
# When present at `npm run tauri:build` time, these are embedded into the app
# and the in-app "Sending Settings" card is hidden from users.
#
# SECURITY NOTE: embedded values can be extracted from the binary by a
# determined user. Use a shared low-privilege service account (e.g. gckops)
# with an app-specific password, and rotate credentials periodically.

EMBED_SMTP_HOST=smtp.office365.com
EMBED_SMTP_PORT=587
EMBED_EMAIL_USER=
EMBED_EMAIL_PASSWORD=
EMBED_SLACK_BOT_TOKEN=

# Looker auto-fetch (Top Bundle / DoD Performance Change Analysis): the channel Looker
# posts the daily TSV to, and a bot token with files:read on it. Needed for the desktop
# "Fetch latest from Slack" button. Token falls back to EMBED_SLACK_BOT_TOKEN if left blank.
EMBED_LOOKER_SLACK_CHANNEL=
EMBED_LOOKER_SLACK_BOT_TOKEN=

# Capacity Monitoring auto-fetch: the channel Helix posts the daily "Capacity Monitor" CSV
# to, and a bot token with files:read. Needed for the desktop "Fetch latest from Slack"
# button on Capacity Monitoring. Token falls back to EMBED_SLACK_BOT_TOKEN if left blank.
EMBED_CAPACITY_SLACK_CHANNEL=
EMBED_CAPACITY_SLACK_BOT_TOKEN=

# Brain LLM (AI narrative for Top Bundle / Capacity): an API key for the OpenAI-compatible
# Brain endpoint, plus which instance it targets. The key stays in Rust (never in the
# frontend bundle). EMBED_BRAIN_LLM_ENV is "stage" (non-prod keys) or "prod"; defaults to
# stage. Non-prod keys work only against the stage instance.
EMBED_BRAIN_LLM_API_KEY=
EMBED_BRAIN_LLM_ENV=stage
